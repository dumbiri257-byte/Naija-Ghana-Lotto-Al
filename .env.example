# Firebase Configuration (Backend Only - Never commit .env file)
FIREBASE_KEY_PATH=firebase_key.json
FIREBASE_PROJECT_ID=naijalotto-7803a

# Scraper Configuration
GHANA_NLA_URL=https://your-ghana-nla-endpoint.com/results
BABA_IJEBU_URL=https://your-baba-ijebu-endpoint.com/results
SCRAPER_TIMEOUT=15
SCRAPER_MAX_RETRIES=3

# Admin Configuration
ADMIN_AUTH_METHOD=firebase  # Options: firebase, api_key, oauth
ADMIN_API_KEY=your-secure-api-key-here

# Database Configuration
FIRESTORE_REGION=us-central1
DATABASE_CACHE_TTL=300  # seconds

# Security
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600  # seconds
ENABLE_CSRF_PROTECTION=true

# Logging
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/lotto_ai.log

# Frontend (Client-side)
REACT_APP_FIREBASE_API_KEY_PUBLIC=AIzaSy...(only public API key)
REACT_APP_API_ENDPOINT=https://api.lottoai.africa
REACT_APP_ENVIRONMENT=production  # Options: development, staging, production
