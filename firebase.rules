rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // SECURITY RULES FOR draw_results COLLECTION
    // ============================================
    match /draw_results/{drawId} {
      // READ: Public read access
      allow read: if request.auth != null || true;  // Allow public read for educational archive
      
      // CREATE: Only authenticated admin users with custom claims
      allow create: if request.auth != null && 
                       request.auth.token.admin == true &&
                       validateDrawFields(request.resource.data);
      
      // UPDATE: Only admin who created it
      allow update: if request.auth != null &&
                       request.auth.token.admin == true &&
                       validateDrawFields(request.resource.data);
      
      // DELETE: Only admin users
      allow delete: if request.auth != null &&
                       request.auth.token.admin == true;
    }
    
    // ============================================
    // SECURITY RULES FOR forum_posts COLLECTION
    // ============================================
    match /forum_posts/{postId} {
      // READ: Public read access
      allow read: if true;  // Educational discussion board
      
      // CREATE: Authenticated users only
      allow create: if request.auth != null &&
                       validateForumPost(request.resource.data) &&
                       request.resource.data.author == request.auth.uid &&
                       rateLimit();
      
      // UPDATE: Only author or admin
      allow update: if (request.auth.uid == resource.data.author || 
                        request.auth.token.admin == true) &&
                       validateForumPost(request.resource.data);
      
      // DELETE: Author or admin
      allow delete: if (request.auth.uid == resource.data.author || 
                        request.auth.token.admin == true);
    }
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    // Validate draw result fields
    function validateDrawFields(data) {
      return data.keys().hasAll(['title', 'day', 'month', 'year', 'numbers', 'channel']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.day is string && data.day.matches(r'^\d{2}$') &&
             data.month is string && data.month.size() <= 20 &&
             data.year is string && data.year.matches(r'^\d{4}$') &&
             data.numbers is string && data.numbers.size() <= 50 &&
             data.channel is string && data.channel.size() > 0 &&
             (!('machine' in data) || (data.machine is string && data.machine.size() <= 50));
    }
    
    // Validate forum post fields
    function validateForumPost(data) {
      return data.keys().hasAll(['author', 'message', 'game']) &&
             data.author is string &&
             data.message is string && 
             data.message.size() > 0 && data.message.size() <= 500 &&
             data.game is string && data.game.size() > 0 &&
             !data.message.matches(r'.*<script.*</script>.*') &&  // No script tags
             !data.message.matches(r'.*javascript:.*');  // No javascript protocol
    }
    
    // Rate limiting: Max 5 posts per user per hour
    function rateLimit() {
      return request.auth.uid != null &&
             getAfter(/databases/$(database)/documents/forum_posts)
               .where('author', '==', request.auth.uid)
               .where('timestamp', '>', now - duration.value(1, 'h'))
               .size() < 5;
    }
  }
}
